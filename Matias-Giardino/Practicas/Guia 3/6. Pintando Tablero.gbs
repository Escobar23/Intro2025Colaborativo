/*

6.​ Pintando el tablero
Escribir un procedimiento PintarElTableroDeAzul() que, asumiendo que el tablero tiene 10
celdas de largo y 7 celdas de alto, pinte absolutamente todo el tablero con bolitas azules, dejando
exactamente una bolita azul en cada celda.
a.​ ¿Cuál es la precondición del procedimiento?
b.​ ¿Se le ocurre otra estrategia para resolver el problema?
Importante: Recuerde que la estrategia de solución debe quedar clara a partir de la lectura del código.
Use subtareas con nombres apropiados para dicho objetivo.

*/

procedure PintarElTableroDeAzul() {
    /*
    proposito: pinta absolutamente todo el tablero con bolitas azules dejando una bolita azul en cada celda
    precondiciones: debe haber al menos 9 celdas hacia el Este, 6 celdas hacia el norte y las mismas deben
    estar vacias.
    observaciones: ninguna 
    */

    repeat(6) {
    DibujarFilaDeBolitasAzules()
    PasarAProximaFila()
    }
    DibujarFilaDeBolitasAzules()


}

procedure DibujarFilaDeBolitasAzules() {
    /*
    proposito: dibujar una fila de bolitas azules de 7 celdas de largo hacia el Este
    precondiciones: debe haber al menos 6 celdas libres hacia el Este
    observaciones: ninguna
    */

    repeat(6) {
        Poner(Azul)
        Mover(Este)
    }
    Poner(Azul)

}

procedure PasarAProximaFila() {
    /*
    proposito: ubica el cabezal 1 celda al norte y al borde oeste de la posicion actual del cabezal
    precondiciones: debe haber al menos 1 celda hacia el norte
    observaciones: ninguna
    */

    Mover(Norte)
    IrAlBorde(Oeste)

}