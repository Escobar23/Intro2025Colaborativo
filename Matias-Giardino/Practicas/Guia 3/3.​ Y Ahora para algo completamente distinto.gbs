program {

}

procedure Poner6DeColorNegro() {
    /*
        proposito: poner 6 bolitas de color Negro en la celda actual
        precondiciones: ninguna
        observaciones: ninguna
    
    */

    repeat(6) {
        Poner(Negro)
    }
}