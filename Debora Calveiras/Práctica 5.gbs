// Ejercicio 4
program{
    DibujarLaBandaGloriosaDeAncho_(6)
}

procedure DibujarLaBandaGloriosaDeAncho_(ancho) {
    /*
        PROPÓSITO: Dibujar banda gloriosa de color rojo 
        PARÁMETROS: 
            * ancho: número - cantidad de celdas de largo de la banda diagonal a dibujar.
        PRECONDICIONES:
            * Debe haber al menos cuatro celdas de alto y debe haber al menos **ancho** celdas de largo.
    */
    DibujarColumnaDeLaBandaGloriosa_Veces(4)
    repeat(ancho - 1){
        IrALaSiguienteColumnaDeLaBandaGloriosaHaciaEl_(Este)
        DibujarColumnaDeLaBandaGloriosa_Veces(4)
    }
    VolverAlInicioDeLaColumnaDeLaBandaGloriosa(5, Sur)
}

procedure DibujarColumnaDeLaBandaGloriosa_Veces(cantidad){
    /*
        PROPÓSITO: Dibujar columna de la banda gloriosa de la cantida de **cantidad** celdas de alto.
        PARÁMETROS: 
            * cantidad: número - cantidad de bolidas de color rojo a poner en la columna.
        PRECONDICIONES:
            * Debe haber la cantidad de **cantidad** celdas hacia el norte desde la celda actual.  
    */
    Poner(Rojo)
    repeat (cantidad - 1) {
        Mover(Norte)
        Poner(Rojo)
    }
    Mover_VecesAl_ (3, Sur)
}

procedure IrALaSiguienteColumnaDeLaBandaGloriosaHaciaEl_(dirección) {
    /*
        PROPÓSITO: Mover el cabezal hacia la siguiente columna de la banda gloriosa en dirección **dirección**
        PARÁMETROS:
            * dirección: dirección - Dirección hacia donde se mueve el cabezal hacia la siguiente columna. 
        PRECONDICIONES:
            * Debe haber al menos una celda hacia la dirección **dirección**.
    */
    Mover(dirección)
    Mover(previo(dirección))
}

procedure VolverAlInicioDeLaColumnaDeLaBandaGloriosa(cantidad, dirección) {
    /*
        PROPÓSITO: Mover el cabezal la cantidad de **cantidad** veces en la dirección **dirección**
        PARÁMETROS:
            * cantidad: número - cantidad de veces que se mueve el cabezal 
            * dirección: dirección - dirección hacia donde se mueve el cabezal
        PRECONDICIONES:
            * Debe haber al menos una celda en la dirección **dirección**
    */
    repeat (cantidad) {
        Mover(dirección)
        Mover(siguiente(dirección))
    }
}

procedure Mover_VecesAl_ (cantidadAMover, direccionAMover) {
    repeat (cantidadAMover) {
        Mover (direccionAMover)
    }
}

// Ejercicio 8

program {
    DibujarBandaDeAlto_YAncho_DeColor_(3, 5, Negro)
}

procedure DibujarBandaDeAlto_YAncho_DeColor_(alto,
ancho, color) {
    /*
        PROPÓSITO: dijar banda de color **color** de **Alto** celdas de alto y **ancho** celdas de ancho.  
        PARÁMETROS:
            * alto: número - número de alto de la banda a dibujar
            * ancho: número - número de ancho de la banda a dibujar
            * color: color - color de las bolitas a poner
        PRECONDICIONES:
            * Debe haber al menos **alto** celdas de alto y **ancho** celdas de ancho. 
    */
    DibujarColumnaDeLaBanda_Veces(3)
    repeat (ancho -1) {
        IrALaSiguienteColumnaDeLaBandaHaciaEl_(Este)
        DibujarColumnaDeLaBanda_Veces(3)
    }
    VolverAlInicioDeLaColumnaDeLaBanda(4, Sur)
}

procedure DibujarColumnaDeLaBanda_Veces(cantidad) {
    /*
        PROPÓSITO: Dibujar columna de la banda de la cantida de **cantidad** celdas de alto.
        PARÁMETROS: 
            * cantidad: número - cantidad de bolidas de color negro a poner en la columna.
        PRECONDICIONES:
            * Debe haber la cantidad de **cantidad** celdas hacia el norte desde la celda actual.  
    */
    Poner(Negro)
    repeat (cantidad - 1) {
        Mover(Norte)
        Poner(Negro)
    }
    Mover_VecesAl_ (2, Sur)
}

procedure IrALaSiguienteColumnaDeLaBandaHaciaEl_(dirección) {
    /*
        PROPÓSITO: Mover el cabezal hacia la siguiente columna de la banda en dirección **dirección**
        PARÁMETROS:
            * dirección: dirección - Dirección hacia donde se mueve el cabezal hacia la siguiente columna. 
        PRECONDICIONES:
            * Debe haber al menos una celda hacia la dirección **dirección**.
    */
    Mover(dirección)
    Mover(previo(dirección))
}

procedure VolverAlInicioDeLaColumnaDeLaBanda(cantidad, dirección) {
    /*
        PROPÓSITO: Mover el cabezal la cantidad de **cantidad** veces en la dirección **dirección**
        PARÁMETROS:
            * cantidad: número - cantidad de veces que se mueve el cabezal 
            * dirección: dirección - dirección hacia donde se mueve el cabezal
        PRECONDICIONES:
            * Debe haber al menos una celda en la dirección **dirección**
    */
    repeat (cantidad) {
        Mover(dirección)
        Mover(siguiente(dirección))
    }
}

procedure Mover_VecesAl_ (cantidadAMover, direccionAMover) {
    repeat (cantidadAMover) {
        Mover (direccionAMover)
    }
}
